---
import Layout from "../layouts/Layout.astro";
import { projects } from "../data/projects.ts";
---

<Layout title="Negin Sheibani — Product Designer">
	<!--
		Symmetric reveal, top and bottom (ref: skizophonic.com's footer,
		mirrored for the hero):

		.sticky-nav (name + nav) stays pinned to the top always. Below it,
		.hero-fixed (the about paragraph) and .reveal-footer (the contact
		section) are both `position: fixed` panels sitting BEHIND the
		opaque scrolling content (.page-cover, via its .wrap children).
		.hero-spacer and .footer-spacer reserve each fixed panel's real
		height in scroll room at the top and bottom of that opaque content,
		kept in sync by ResizeObservers below — so scrolling to the very
		top reveals the hero out from under the nav, and scrolling to the
		very bottom reveals the footer, the same mechanic both ways.
	-->
	<div class="sticky-nav">
		<div class="header-top">
			<div class="name-row">
				<img class="site-logo" src="/about-illustration.svg" alt="" width="34" height="24" />
				<h1>Negin Sheibani</h1>
			</div>
			<nav class="nav" aria-label="Primary">
				<a href="/">Work</a>, <a href="/resume.pdf" target="_blank" rel="noopener noreferrer">Resume</a>, <a href="mailto:neginxsheibani@gmail.com">Connect</a>
			</nav>
		</div>
	</div>

	<div class="hero-fixed">
		<div class="about-row">
			<p class="about">About paragraph goes here — a few lines on what you do and how you think about it.</p>
		</div>
	</div>

	<div class="page-cover">
		<div class="hero-spacer" aria-hidden="true"></div>

		<div class="wrap">
			<hr class="section-divider" />

			<div class="grid">
				{projects.map((p, i) => (
					<a class="card" href={`/case-studies/${p.slug}/`} data-index={i}>
						<div class="card-cover" style={`background:${p.color}`}>
							<span class="glyph">{p.title.charAt(p.title.length - 1)}</span>
						</div>
						<div class="card-body">
							<div class="card-title-row">
								<span class="card-dot" style={`background:${p.color}`}></span>
								{p.title}
							</div>
							<p class="card-meta">{p.category} · {p.year}</p>
						</div>
					</a>
				))}
			</div>
		</div>

		<div class="footer-spacer" aria-hidden="true"></div>
	</div>

	<footer class="reveal-footer">
		<div class="wrap">
			<hr class="section-divider" />

			<section class="contact-footer" id="contact">
				<p class="contact-status">Open to new opportunities</p>
				<h2 class="contact-heading">Let's work together.</h2>
				<a class="contact-email" href="mailto:neginxsheibani@gmail.com">neginxsheibani@gmail.com</a>
				<div class="contact-links">
					<a class="contact-link" href="mailto:neginxsheibani@gmail.com">
						Email <span aria-hidden="true">↗</span>
					</a>
					<a class="contact-link" href="/resume.pdf" target="_blank" rel="noopener noreferrer">
						Resume <span aria-hidden="true">↗</span>
					</a>
					<a class="contact-link" href="https://www.linkedin.com/in/negin-ssheibani" target="_blank" rel="noopener noreferrer">
						LinkedIn <span aria-hidden="true">↗</span>
					</a>
				</div>
			</section>

			<div class="footer">
				<span>&copy; {new Date().getFullYear()} Negin Sheibani</span>
				<span>Built with Astro</span>
			</div>
		</div>
	</footer>

	<script>
		// Keep each spacer's height matched to its fixed panel's real
		// height, and the hero's top offset matched to the sticky nav's
		// real height. ResizeObservers watch the actual elements, so they
		// re-sync on ANY size change — webfont swap, window resize, zoom,
		// later content edits — rather than only specific events we
		// happened to think to listen for (fonts load asynchronously, so a
		// one-shot measurement + `resize` listener alone can go stale with
		// nothing to catch it).
		function watch(el: HTMLElement | null, cssVar: string, prop: "offsetHeight" = "offsetHeight") {
			if (!el) return;
			const sync = () => document.documentElement.style.setProperty(cssVar, `${el[prop]}px`);
			sync();
			if ("ResizeObserver" in window) {
				new ResizeObserver(sync).observe(el);
			} else {
				window.addEventListener("resize", sync);
				document.fonts?.ready?.then(sync);
			}
		}

		watch(document.querySelector(".sticky-nav"), "--nav-height");
		watch(document.querySelector(".hero-fixed"), "--hero-height");
		watch(document.querySelector(".reveal-footer"), "--footer-height");
	</script>

	<script>
		// Scroll-in reveal for project cards (ref: mynrd.co.uk's project grid).
		// Each card starts translated/scaled down via CSS and gets `.in-view`
		// added the moment it enters the viewport, which triggers the CSS
		// transition. Cards in the same row are staggered slightly by column.
		const cards = document.querySelectorAll<HTMLElement>(".card");
		const columns = getComputedStyle(document.querySelector(".grid")!).gridTemplateColumns.split(" ").length;

		const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

		if (reduceMotion || !("IntersectionObserver" in window)) {
			cards.forEach((card) => card.classList.add("in-view"));
		} else {
			const observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (!entry.isIntersecting) return;
						const card = entry.target as HTMLElement;
						const index = Number(card.dataset.index ?? 0);
						const delay = (index % columns) * 90;
						card.style.transitionDelay = `${delay}ms`;
						card.classList.add("in-view");
						observer.unobserve(card);
					});
				},
				{ threshold: 0.15, rootMargin: "0px 0px -40px 0px" },
			);

			cards.forEach((card) => observer.observe(card));
		}
	</script>
</Layout>
