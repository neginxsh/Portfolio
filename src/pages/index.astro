---
import Layout from "../layouts/Layout.astro";
import { projects } from "../data/projects.ts";
---

<Layout title="Negin Sheibani — Product Designer">
	<!--
		Symmetric reveal, top and bottom (ref: skizophonic.com's footer,
		mirrored for the hero):

		.sticky-nav (name + nav) stays pinned to the top always. Below it,
		.hero-fixed (the about paragraph) and .reveal-footer (the contact
		section) are both `position: fixed` panels sitting BEHIND the
		opaque scrolling content (.page-cover, via its .wrap children).
		.hero-spacer and .footer-spacer reserve each fixed panel's real
		height in scroll room at the top and bottom of that opaque content,
		kept in sync by ResizeObservers below — so scrolling to the very
		top reveals the hero out from under the nav, and scrolling to the
		very bottom reveals the footer, the same mechanic both ways.
	-->
	<div class="sticky-nav">
		<div class="header-top">
			<div class="name-row">
				<h1>Negin Sheibani</h1>
			</div>
			<nav class="nav" aria-label="Primary">
				<a href="/">Work</a>, <a href="/resume.pdf" target="_blank" rel="noopener noreferrer">Resume</a>, <a href="mailto:neginxsheibani@gmail.com">Connect</a>
			</nav>
		</div>
	</div>

	<div class="hero-fixed">
		<div class="about-row">
			<p class="about">About paragraph goes here — a few lines on what you do and how you think about it.</p>
		</div>
	</div>

	<div class="page-cover">
		<div class="hero-spacer" aria-hidden="true"></div>

		<div class="wrap">
			<hr class="section-divider" />

			<div class="grid">
				{projects.map((p, i) => (
					<a class="card" href={`/case-studies/${p.slug}/`} data-index={i}>
						<div class="card-cover" style={`background:${p.color}`}>
							<span class="glyph">{p.title.charAt(p.title.length - 1)}</span>
						</div>
						<div class="card-body">
							<div class="card-title-row">
								<span class="card-dot" style={`background:${p.color}`}></span>
								{p.title}
							</div>
							<p class="card-meta">{p.category} · {p.year}</p>
						</div>
					</a>
				))}
			</div>
		</div>

		<div class="footer-spacer" aria-hidden="true"></div>
	</div>

	<footer class="reveal-footer">
		<div class="wrap">
			<hr class="section-divider" />

			<section class="contact-footer" id="contact">
				<div class="contact-footer-row">
					<div class="contact-footer-main">
						<p class="contact-status">Open to new opportunities</p>
						<h2 class="contact-heading">Let's work together.</h2>
						<span class="email-badge-wrap">
							<button type="button" class="contact-email" data-email="neginxsheibani@gmail.com">
								neginxsheibani@gmail.com
							</button>
							<!--
								Rotating circular "copy" badge (ref: xhulia.com's
								email hover — a small looping-text badge on a
								curved SVG path, positioned next to the link, not
								following the cursor). Two <textPath> variants
								(default / copied) sit stacked in the same spot;
								the script below toggles which is visible on
								click instead of mutating text content, so the
								looping duplicate phrase stays intact.
							-->
							<span class="email-badge" aria-hidden="true">
								<svg class="email-badge-spin" viewBox="0 0 100 100">
									<defs>
										<path id="email-badge-circle" d="M 50,50 m -35,0 a 35,35 0 1,1 70,0 a 35,35 0 1,1 -70,0" />
									</defs>
									<text class="email-badge-text email-badge-text-default">
										<textPath href="#email-badge-circle">Copy email · Copy email · </textPath>
									</text>
									<text class="email-badge-text email-badge-text-copied">
										<textPath href="#email-badge-circle">Copied! · Copied! · </textPath>
									</text>
								</svg>
							</span>
						</span>
						<span class="sr-only" role="status" aria-live="polite"></span>
						<div class="contact-links">
							<a class="contact-link" href="mailto:neginxsheibani@gmail.com">
								Connect <span aria-hidden="true">↗</span>
							</a>
							<a class="contact-link" href="https://www.linkedin.com/in/negin-ssheibani" target="_blank" rel="noopener noreferrer">
								LinkedIn <span aria-hidden="true">↗</span>
							</a>
							<a class="contact-link" href="/resume.pdf" target="_blank" rel="noopener noreferrer">
								Resume <span aria-hidden="true">↗</span>
							</a>
						</div>
					</div>
					<div class="contact-illustration-stack">
						<img class="illustration-frame" src="/about-illustration.svg" alt="" style="opacity: 1;" />
						<img class="illustration-frame" src="/about-illustration-mid.svg" alt="" style="opacity: 0;" />
						<img class="illustration-frame" src="/about-illustration-deep.svg" alt="" style="opacity: 0;" />
					</div>
				</div>
			</section>

			<div class="footer">
				<span>&copy; {new Date().getFullYear()} Negin Sheibani</span>
				<span>Built with Astro</span>
			</div>
		</div>
	</footer>

	<script>
		// Keep each spacer's height matched to its fixed panel's real
		// height, and the hero's top offset matched to the sticky nav's
		// real height. ResizeObservers watch the actual elements, so they
		// re-sync on ANY size change — webfont swap, window resize, zoom,
		// later content edits — rather than only specific events we
		// happened to think to listen for (fonts load asynchronously, so a
		// one-shot measurement + `resize` listener alone can go stale with
		// nothing to catch it).
		function watch(el: HTMLElement | null, cssVar: string, prop: "offsetHeight" = "offsetHeight") {
			if (!el) return;
			const sync = () => document.documentElement.style.setProperty(cssVar, `${el[prop]}px`);
			sync();
			if ("ResizeObserver" in window) {
				new ResizeObserver(sync).observe(el);
			} else {
				window.addEventListener("resize", sync);
				document.fonts?.ready?.then(sync);
			}
		}

		watch(document.querySelector(".sticky-nav"), "--nav-height");
		watch(document.querySelector(".hero-fixed"), "--hero-height");
		watch(document.querySelector(".reveal-footer"), "--footer-height");
	</script>

	<script>
		// Illustration crossfade, scrubbed by how far into the footer's
		// reveal you've scrolled (ref: the three states supplied — 13 is
		// the resting/default frame, 12 and 11 are progressively deeper
		// ones) — not a one-shot triggered animation, so scrolling back up
		// smoothly reverses it back to the default frame exactly as it
		// arrived, at whatever point you stop.
		//
		// Progress is derived from scroll position rather than an
		// IntersectionObserver on the footer itself: .reveal-footer is
		// `position: fixed`, so it always geometrically intersects the
		// viewport regardless of whether the opaque scrolling content is
		// currently covering it — IntersectionObserver has no way to know
		// it's being covered. Distance from the actual bottom of the page,
		// measured against the footer's own real height (--footer-height,
		// kept in sync above), gives the same 0→1 reveal fraction the
		// cover/spacer mechanic itself uses, with no extra bookkeeping.
		const frames = document.querySelectorAll<HTMLElement>(".illustration-frame");

		if (frames.length === 3) {
			const [frame1, frame2, frame3] = frames;

			function footerProgress() {
				const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
				const footerHeight = parseFloat(
					getComputedStyle(document.documentElement).getPropertyValue("--footer-height"),
				);
				if (!(maxScroll > 0) || !(footerHeight > 0)) return 0;
				const distanceFromBottom = maxScroll - window.scrollY;
				return Math.min(1, Math.max(0, 1 - distanceFromBottom / footerHeight));
			}

			function applyProgress(p: number) {
				// p 0 → frame1 (13) fully shown; 0.5 → frame2 (12) fully
				// shown; 1 → frame3 (11) fully shown. Two linear crossfades
				// back to back, same idea as a two-stop gradient.
				const seg = p * 2;
				const o1 = Math.max(0, 1 - seg);
				const o3 = Math.max(0, seg - 1);
				const o2 = 1 - o1 - o3;
				frame1.style.opacity = String(o1);
				frame2.style.opacity = String(o2);
				frame3.style.opacity = String(o3);
			}

			// No rAF throttling — three `opacity` writes plus a bit of
			// arithmetic is cheap enough to run directly on every scroll
			// event, and it sidesteps rAF getting silently starved (e.g. a
			// backgrounded tab never firing it, which would otherwise wedge
			// this permanently since a stuck `ticking` flag never clears).
			function onScroll() {
				applyProgress(footerProgress());
			}

			window.addEventListener("scroll", onScroll, { passive: true });
			window.addEventListener("resize", onScroll);
			onScroll();
		}
	</script>

	<script>
		// Click-to-copy email. The address on the button never changes; on
		// click it's copied to the clipboard, the rotating badge next to it
		// (see .email-badge-wrap) swaps from its default loop to a
		// "Copied!" loop for a moment, and an aria-live region announces it
		// for keyboard/touch/screen-reader users who never see a hover
		// badge at all (it's a :hover-driven affordance, mouse-only).
		const emailButton = document.querySelector<HTMLButtonElement>(".contact-email");
		const emailBadgeWrap = document.querySelector<HTMLElement>(".email-badge-wrap");
		const status = document.querySelector<HTMLElement>(".contact-footer-main .sr-only");

		if (emailButton) {
			const address = emailButton.dataset.email ?? emailButton.textContent!.trim();
			let revertTimer: ReturnType<typeof setTimeout>;

			emailButton.addEventListener("click", async () => {
				try {
					await navigator.clipboard.writeText(address);
				} catch {
					// Clipboard API unavailable/blocked — still show the
					// confirmation so the click doesn't feel like a no-op;
					// worst case they select/copy the address manually.
				}

				clearTimeout(revertTimer);
				emailButton.classList.add("is-copied");
				emailBadgeWrap?.classList.add("is-copied");
				if (status) status.textContent = "Email address copied to clipboard.";

				revertTimer = setTimeout(() => {
					emailButton.classList.remove("is-copied");
					emailBadgeWrap?.classList.remove("is-copied");
				}, 1600);
			});
		}
	</script>

	<script>
		// Scroll-in reveal for project cards (ref: mynrd.co.uk's project grid).
		// Each card starts translated/scaled down via CSS and gets `.in-view`
		// added the moment it enters the viewport, which triggers the CSS
		// transition. Cards in the same row are staggered slightly by column.
		const cards = document.querySelectorAll<HTMLElement>(".card");
		const columns = getComputedStyle(document.querySelector(".grid")!).gridTemplateColumns.split(" ").length;

		const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

		if (reduceMotion || !("IntersectionObserver" in window)) {
			cards.forEach((card) => card.classList.add("in-view"));
		} else {
			const observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (!entry.isIntersecting) return;
						const card = entry.target as HTMLElement;
						const index = Number(card.dataset.index ?? 0);
						const delay = (index % columns) * 90;
						card.style.transitionDelay = `${delay}ms`;
						card.classList.add("in-view");
						observer.unobserve(card);
					});
				},
				{ threshold: 0.15, rootMargin: "0px 0px -40px 0px" },
			);

			cards.forEach((card) => observer.observe(card));
		}
	</script>
</Layout>
