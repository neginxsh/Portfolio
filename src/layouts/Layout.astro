---
import "../styles/global.css";

interface Props {
	title: string;
	description?: string;
}

const {
	title,
	description = "Negin Sheibani — Product Designer. Selected product & design work.",
} = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<!-- Light only, deliberately — keeps browser chrome (scrollbars, form
		     controls) light even if the OS/browser is set to dark mode. -->
		<meta name="color-scheme" content="light" />
		<link rel="icon" type="image/svg+xml" href="/about-illustration.svg" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Averia+Serif+Libre:ital,wght@0,300;0,400;0,700;1,300;1,400;1,700&family=Instrument+Serif:ital@0;1&display=swap"
			rel="stylesheet"
		/>

		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta name="twitter:card" content="summary" />

		<title>{title}</title>
	</head>
	<body>
		<!--
			Custom cursor, matched to jingjinghan.com's actual values: a
			mix-blend-mode: difference white circle, 16px by default, 44px
			over ordinary links/buttons, 150px with a fade/scale-in label
			over "preview" style links (data-cursor-view — our project
			cards). Suppressed (native cursor shown instead) while hovering
			.sticky-nav, same as that site does for its own nav. Only shown
			once the script below confirms a fine pointer AND actually
			runs — the native cursor is hidden only via a class it adds,
			never by default CSS, so a JS failure can't leave someone with
			no cursor at all.
		-->
		<div class="cursor-dot" aria-hidden="true"><span class="cursor-label"></span></div>
		<slot />
		<script>
			if (window.matchMedia("(pointer: fine)").matches) {
				const dot = document.querySelector<HTMLElement>(".cursor-dot");
				const label = dot?.querySelector<HTMLElement>(".cursor-label");
				if (dot && label) {
					document.documentElement.classList.add("has-custom-cursor");

					let seen = false;

					window.addEventListener(
						"mousemove",
						(e) => {
							if (!seen) {
								seen = true;
								dot.classList.add("is-active");
							}
							// No transition on transform (see global.css), so
							// this stays a plain, un-eased value the dot can
							// track every frame without lag.
							dot.style.transform = `translate3d(${e.clientX}px, ${e.clientY}px, 0) translate(-50%, -50%)`;
						},
						{ passive: true },
					);
					window.addEventListener("mouseleave", () => dot.classList.remove("is-active"));

					document.addEventListener("mouseover", (e) => {
						const target = e.target as HTMLElement;

						const nav = target.closest(".sticky-nav");
						if (nav) {
							document.documentElement.classList.add("nav-hovering");
							nav.classList.add("nav-native-cursor");
							return;
						}

						const viewTarget = target.closest<HTMLElement>("[data-cursor-view]");
						if (viewTarget) {
							label.textContent = viewTarget.dataset.cursorView ?? "";
							dot.classList.add("is-view");
							return;
						}

						if (target.closest("a, button")) dot.classList.add("is-hover");
					});
					document.addEventListener("mouseout", (e) => {
						const target = e.target as HTMLElement;

						const nav = target.closest(".sticky-nav");
						if (nav) {
							document.documentElement.classList.remove("nav-hovering");
							nav.classList.remove("nav-native-cursor");
						}

						if (target.closest("[data-cursor-view]")) dot.classList.remove("is-view");
						if (target.closest("a, button")) dot.classList.remove("is-hover");
					});
				}
			}
		</script>
	</body>
</html>
