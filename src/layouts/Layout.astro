---
import "../styles/global.css";

interface Props {
	title: string;
	description?: string;
}

const {
	title,
	description = "Negin Sheibani — Product Designer. Selected product & design work.",
} = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<!-- Light only, deliberately — keeps browser chrome (scrollbars, form
		     controls) light even if the OS/browser is set to dark mode. -->
		<meta name="color-scheme" content="light" />
		<link rel="icon" type="image/svg+xml" href="/about-illustration.svg" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Averia+Serif+Libre:ital,wght@0,300;0,400;0,700;1,300;1,400;1,700&family=Instrument+Serif:ital@0;1&display=swap"
			rel="stylesheet"
		/>

		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta name="twitter:card" content="summary" />

		<title>{title}</title>
	</head>
	<body>
		<!--
			Custom cursor: a solid accent-blue dot that never changes color,
			only size — bigger over links/buttons. What DOES change color is
			the text directly underneath it, which turns white in a circle
			matching the dot (see .reveal-text in global.css) — a "spotlight"
			effect rather than the dot itself flipping color. Plus a
			cursor-following label pill for elements that want to name their
			action (ref: xhulia.com's email hover). Only shown once the
			script below confirms a fine pointer AND actually runs — the
			native cursor is hidden only via a class it adds, never by
			default CSS, so a JS failure can't leave someone with no cursor
			at all.
		-->
		<div class="cursor-dot" aria-hidden="true"></div>
		<div class="cursor-label" aria-hidden="true"><span class="cursor-label-inner"></span></div>
		<slot />
		<script>
			if (window.matchMedia("(pointer: fine)").matches) {
				const dot = document.querySelector<HTMLElement>(".cursor-dot");
				const label = document.querySelector<HTMLElement>(".cursor-label");
				const labelInner = label?.querySelector<HTMLElement>(".cursor-label-inner");
				if (dot && label && labelInner) {
					document.documentElement.classList.add("has-custom-cursor");

					let seen = false;
					let revealTarget: HTMLElement | null = null;

					window.addEventListener(
						"mousemove",
						(e) => {
							if (!seen) {
								seen = true;
								dot.classList.add("is-active");
							}
							// Position only — no scale/other property shares
							// this transition, so it stays a plain, un-eased
							// value the dot/label can track every frame
							// without lag (ditto the reveal circle below,
							// updated with the same raw, un-eased numbers).
							const move = `translate3d(${e.clientX}px, ${e.clientY}px, 0) translate(-50%, -50%)`;
							dot.style.transform = move;
							label.style.transform = move;

							if (revealTarget) {
								const rect = revealTarget.getBoundingClientRect();
								revealTarget.style.setProperty("--reveal-x", `${e.clientX - rect.left}px`);
								revealTarget.style.setProperty("--reveal-y", `${e.clientY - rect.top}px`);
							}
						},
						{ passive: true },
					);
					window.addEventListener("mouseleave", () => dot.classList.remove("is-active"));

					// The site's actual text-bearing elements — deliberately
					// an explicit list rather than a generic "leaf node"
					// heuristic, since several of these (e.g. .contact-link)
					// nest a decorative icon span inside their text, which a
					// leaf check would incorrectly disqualify.
					const REVEAL_SELECTOR = "h1, h2, p, a, .card-title-row, .footer span";

					function startReveal(el: HTMLElement, isLink: boolean) {
						revealTarget = el;
						// Captured before .reveal-text sets color:transparent,
						// so the gradient's "outside the circle" stop matches
						// whatever color this element actually renders in
						// (muted footer text, faint card meta, etc.) without
						// needing a hand-written override per selector.
						el.style.setProperty("--reveal-base", getComputedStyle(el).color);
						el.style.setProperty("--reveal-r", isLink ? "23px" : "7px");
						el.classList.add("reveal-text");
					}
					function endReveal(el: HTMLElement) {
						el.classList.remove("reveal-text");
						el.style.removeProperty("--reveal-base");
						el.style.removeProperty("--reveal-r");
						el.style.removeProperty("--reveal-x");
						el.style.removeProperty("--reveal-y");
						if (revealTarget === el) revealTarget = null;
					}

					document.addEventListener("mouseover", (e) => {
						const target = e.target as HTMLElement;
						const labelTarget = target.closest<HTMLElement>("[data-cursor-label]");
						if (labelTarget) {
							labelInner.textContent = labelTarget.dataset.cursorLabel ?? "";
							label.classList.add("is-active");
							dot.classList.add("is-label");
							return;
						}
						const linkTarget = target.closest("a, button");
						if (linkTarget) dot.classList.add("is-hover");

						const revealEl = target.closest<HTMLElement>(REVEAL_SELECTOR);
						if (revealEl) startReveal(revealEl, !!linkTarget);
					});
					document.addEventListener("mouseout", (e) => {
						const target = e.target as HTMLElement;
						if (target.closest("[data-cursor-label]")) {
							label.classList.remove("is-active");
							dot.classList.remove("is-label");
						}
						if (target.closest("a, button")) dot.classList.remove("is-hover");

						const revealEl = target.closest<HTMLElement>(REVEAL_SELECTOR);
						if (revealEl) endReveal(revealEl);
					});
				}
			}
		</script>
	</body>
</html>
