---
import "../styles/global.css";

interface Props {
	title: string;
	description?: string;
}

const {
	title,
	description = "Negin Sheibani — Product Designer. Selected product & design work.",
} = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Averia+Serif+Libre:ital,wght@0,300;0,400;0,700;1,300;1,400;1,700&family=Instrument+Serif:ital@0;1&display=swap"
			rel="stylesheet"
		/>

		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta name="twitter:card" content="summary" />

		<title>{title}</title>
	</head>
	<body>
		<!--
			Custom cursor dot (ref: jingjinghan.com), in the site accent color
			instead of that site's mix-blend-mode inversion trick. Only shown
			once the script below confirms a fine pointer AND actually runs —
			the native cursor is hidden via a class it adds, never by default
			CSS, so a JS failure can't leave someone with no cursor at all.
		-->
		<div class="cursor-dot" aria-hidden="true"></div>
		<slot />
		<script>
			if (window.matchMedia("(pointer: fine)").matches) {
				const dot = document.querySelector<HTMLElement>(".cursor-dot");
				if (dot) {
					document.documentElement.classList.add("has-custom-cursor");

					let seen = false;
					window.addEventListener(
						"mousemove",
						(e) => {
							if (!seen) {
								seen = true;
								dot.classList.add("is-active");
							}
							dot.style.transform = `translate3d(${e.clientX}px, ${e.clientY}px, 0) translate(-50%, -50%)`;
						},
						{ passive: true },
					);
					window.addEventListener("mouseleave", () => dot.classList.remove("is-active"));
					document.addEventListener("mouseover", (e) => {
						if ((e.target as HTMLElement).closest("a, button")) dot.classList.add("is-hover");
					});
					document.addEventListener("mouseout", (e) => {
						if ((e.target as HTMLElement).closest("a, button")) dot.classList.remove("is-hover");
					});
				}
			}
		</script>
	</body>
</html>
